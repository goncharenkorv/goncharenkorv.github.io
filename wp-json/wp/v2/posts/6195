38\u0442\u0435 \u043a\u0432\u0430\u0434\u0440\u0430\u0442 \u0441 \u0446\u0432\u0435\u0442\u043e\u043c, \u043e\u0442\u043b\u0438\u0447\u0430\u044e\u0449\u0438\u043c\u0441\u044f \u043e\u0442 \u0434\u0440\u0443\u0433\u0438\u0445, \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439 \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438.<\/p>\n\n\n\n<p>\u0422\u0440\u0443\u0434\u043d\u043e \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u0442\u044c \u0446\u0432\u0435\u0442\u0430? \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0446\u0432\u0435\u0442 \u0444\u043e\u043d\u0430 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0443 \u0412\u0430\u0441 \u0432\u0441\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u0441\u044f!<\/p>\n\n\n\n<p>\u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043e\u0431\u0430 \u0433\u043b\u0430\u0437\u0430 \u0438\u043b\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u044c \u043e\u0434\u0438\u043d, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043b\u0443\u0447\u0448\u0435\u0435 \u0437\u0440\u0435\u043d\u0438\u0435.<\/p>\n\n\n\n<p>\u0414\u0430\u043d\u043d\u044b\u0435 \u043f\u043e \u043e\u0447\u043a\u0430\u043c:<\/p>\n\n\n\n<ul><li>30 \u043e\u0447\u043a\u043e\u0432 \u0438\u043b\u0438 \u0431\u043e\u043b\u044c\u0448\u0435 -&gt; \u043e\u0441\u0442\u0440\u043e\u0435 \u0437\u0440\u0435\u043d\u0438\u0435<\/li><li>20-29 \u0431\u0430\u043b\u043b\u043e\u0432 -&gt; \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u0437\u0440\u0435\u043d\u0438\u0435<\/li><li>10-19 \u0431\u0430\u043b\u043b\u043e\u0432 -&gt; \u0441\u043b\u0430\u0431\u043e\u0435 \u0437\u0440\u0435\u043d\u0438\u0435<\/li><li>9 \u043e\u0447\u043a\u0430 \u0438\u043b\u0438 \u043c\u0435\u043d\u044c\u0448\u0435 -&gt; \u0432\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u