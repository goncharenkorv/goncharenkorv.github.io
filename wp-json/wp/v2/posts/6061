43e\u0435\u043c \u043f\u0443\u0442\u0438.<br>\u041a\u043d\u043e\u043f\u043a\u0430-\u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u0438\u0437\u043c\u0435\u043d\u044f\u0435\u0442 \u0432\u0441\u0435 \u043b\u0430\u0441\u0442\u0438\u043a\u0438 \u043d\u0430 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u0435.<br>\u0423\u0441\u043b\u043e\u0436\u043d\u044f\u0435\u0442 \u0437\u0430\u0434\u0430\u0447\u0443 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0445\u043e\u0434\u043e\u0432.<\/p>\n\n\n\n<p>\u0412\u0441\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u044b \u043d\u0430 5 \u0433\u0440\u0443\u043f\u043f \u043f\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0443 \u043f\u043e\u043b\u044f (4&#215;4, 5&#215;5, 6&#215;6, 7&#215;7, 8&#215;8).<br>\u0412 \u043a\u0430\u0436\u0434\u043e\u0439 \u0433\u0440\u0443\u043f\u043f\u0435 \u043f\u043e 1000 \u0443\u0440\u043e\u0432\u043d\u0435\u0439.<\/p>\n\n\n\n<p>\u0412\u0441\u0435\u0433\u043e (5&#215;1000) = 5000 \u0437\u0430\u0434\u0430\u0447.<\/p>\n\n\n\n<p>\u041a\u043d\u043e\u043f\u043a\u0430 &#171;\u0420\u0435\u0448\u0435\u043d\u0438\u0435&#187; \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0431\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439.<\/p>\n\n\n\n<p>\u0418\u0433\u0440\u0430 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u042d\u0442\u043e \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u0433\u0440\u0430-\u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0430, \u0446\u0435\u043b\u044c \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0432\u0441\u0435 \u0442\u043e\u0447\u043a\u0438 \u0441 \u0438\u0433\u0440\u043